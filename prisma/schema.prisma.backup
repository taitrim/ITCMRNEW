model Validatorsubstitutes {
  id        String   @id @default(cuid())
  users Users? @relation("Validatorsubstitutes_users_id", fields: [usersId], references: [id])
  usersId String
  usersIdSubstitute Int
  @@unique([usersId, usersIdSubstitute])
  @@map("glpi_validatorsubstitutes")
}
model Vlans {
  id        String   @id @default(cuid())
  entity Entity @relation("Vlans_entity", fields: [entitiesId], references: [id])
  entitiesId String
  isRecursive Int
  name String?
  comment String?
  tag Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  ipnetworksVlans IpnetworksVlans[] @relation("IpnetworksVlans_vlans_id")
  networkportsVlans NetworkportsVlans[] @relation("NetworkportsVlans_vlans_id")
  @@map("glpi_vlans")
}
model Webhooks {
  id        String   @id @default(cuid())
  entity Entity @relation("Webhooks_entity", fields: [entitiesId], references: [id])
  entitiesId String
  isRecursive Int
  name String?
  comment String?
  webhookcategories Webhookcategories? @relation("Webhooks_webhookcategories_id", fields: [webhookcategoriesId], references: [id])
  webhookcategoriesId String
  itemtype String?
  event String?
  payload String?
  useDefaultPayload Int
  customHeaders String?
  url String?
  secret String?
  useCraChallenge Int
  httpMethod String?
  sentTry Int
  expiration Int
  isActive Int
  saveResponseBody Int
  logInItemHistory Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  useOauth Int
  oauthUrl String?
  clientid String?
  clientsecret String?
  queuedwebhooks Queuedwebhooks[] @relation("Queuedwebhooks_webhooks_id")
  @@map("glpi_webhooks")
}
