generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model Agenttypes {
  id        String   @id @default(cuid())
  name String?
  agents Agents[] @relation("Agents_agenttypes_id")
  @@map("glpi_agenttypes")
}
model Alerts {
  id        String   @id @default(cuid())
  itemtype String
  itemsId Int
  type Int
  date DateTime
  @@unique([itemsId, itemtype, type])
  @@map("glpi_alerts")
}
model Applianceenvironments {
  id        String   @id @default(cuid())
  name String?
  comment String?
  appliances Appliances[] @relation("Appliances_applianceenvironments_id")
  @@map("glpi_applianceenvironments")
}
model AssetsAssetdefinitions {
  id        String   @id @default(cuid())
  systemName String?
  label String
  icon String?
  picture String?
  comment String?
  isActive Int
  capacities String
  profiles String
  translations String
  fieldsDisplay String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([systemName])
  assetsAssetmodels AssetsAssetmodels[] @relation("AssetsAssetmodels_assets_assetdefinitions_id")
  assetsAssets AssetsAssets[] @relation("AssetsAssets_assets_assetdefinitions_id")
  assetsAssettypes AssetsAssettypes[] @relation("AssetsAssettypes_assets_assetdefinitions_id")
  assetsCustomfielddefinitions AssetsCustomfielddefinitions[] @relation("AssetsCustomfielddefinitions_assets_assetdefinitions_id")
  @@map("glpi_assets_assetdefinitions")
}
model AssetsAssetsPeripheralassets {
  id        String   @id @default(cuid())
  itemtypeAsset String
  itemsIdAsset Int
  itemsIdPeripheral Int
  itemtypePeripheral String
  isDeleted Boolean @default(false)
  isDynamic Int
  @@map("glpi_assets_assets_peripheralassets")
}
model Authldaps {
  id        String   @id @default(cuid())
  name String?
  host String?
  basedn String?
  rootdn String?
  port Int
  condition String?
  loginField String?
  syncField String?
  useTls Int
  groupField String?
  groupCondition String?
  groupSearchType Int
  groupMemberField String?
  email1Field String?
  realnameField String?
  firstnameField String?
  phoneField String?
  phone2Field String?
  mobileField String?
  commentField String?
  useDn Int
  timeOffset Int
  derefOption Int
  titleField String?
  categoryField String?
  languageField String?
  updatedAt DateTime @updatedAt
  comment String?
  isDefault Int
  isActive Int
  rootdnPasswd String?
  registrationNumberField String?
  email2Field String?
  email3Field String?
  email4Field String?
  locationField String?
  responsibleField String?
  pagesize Int
  ldapMaxlimit Int
  canSupportPagesize Int
  pictureField String?
  beginDateField String?
  endDateField String?
  createdAt DateTime @default(now())
  inventoryDomain String?
  tlsCertfile String?
  tlsKeyfile String?
  useBind Int
  timeout Int
  tlsVersion String?
  authldapreplicates Authldapreplicates[] @relation("Authldapreplicates_authldaps_id")
  entity Entity[] @relation("Entity_authldaps_id")
  @@map("glpi_authldaps")
}
model Authmails {
  id        String   @id @default(cuid())
  name String?
  connectString String?
  host String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  comment String?
  isActive Int
  isDefault Int
  @@map("glpi_authmails")
}
model Autoupdatesystems {
  id        String   @id @default(cuid())
  name String?
  comment String?
  assetsAssets AssetsAssets[] @relation("AssetsAssets_autoupdatesystems_id")
  clusters Clusters[] @relation("Clusters_autoupdatesystems_id")
  computers Computers[] @relation("Computers_autoupdatesystems_id")
  databaseinstances Databaseinstances[] @relation("Databaseinstances_autoupdatesystems_id")
  monitors Monitors[] @relation("Monitors_autoupdatesystems_id")
  networkequipments Networkequipments[] @relation("Networkequipments_autoupdatesystems_id")
  peripherals Peripherals[] @relation("Peripherals_autoupdatesystems_id")
  phones Phones[] @relation("Phones_autoupdatesystems_id")
  printers Printers[] @relation("Printers_autoupdatesystems_id")
  refusedequipments Refusedequipments[] @relation("Refusedequipments_autoupdatesystems_id")
  unmanageds Unmanageds[] @relation("Unmanageds_autoupdatesystems_id")
  @@map("glpi_autoupdatesystems")
}
model Blacklistedmailcontents {
  id        String   @id @default(cuid())
  name String?
  content String?
  comment String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@map("glpi_blacklistedmailcontents")
}
model Blacklists {
  id        String   @id @default(cuid())
  type Int
  name String?
  value String?
  comment String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@map("glpi_blacklists")
}
