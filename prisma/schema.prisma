generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================================
// 1. ORGANIZATION & USERS (Entities trong GLPI)
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  logo      String?
  website   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  locations       Location[]
  assets          Asset[]
  tickets         Ticket[]
  problems        Problem[]
  changes         Change[]
  categories      Category[]
  contracts       Contract[]
  suppliers       Supplier[]
  kbArticles      KnowledgeBaseArticle[]
  documents       Document[]
  agents          Agent[]
  softwareLicenses SoftwareLicense[]
  consumables     Consumable[]
  budgets         Budget[]
  manufacturers   Manufacturer[]
  states          State[]
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  password       String
  phone          String?
  mobile         String?
  role           String   @default("user") // admin, tech, user
  avatar         String?
  organizationId String
  locationId     String?
  isActive       Boolean  @default(true)
  lastLogin      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  location        Location?    @relation(fields: [locationId], references: [id])
  accounts        Account[]
  sessions        Session[]
  assignedTickets Ticket[]     @relation("AssignedTech")
  createdTickets  Ticket[]     @relation("CreatedBy")
  activities      Activity[]
  documents       Document[]
  assignedAssets  Asset[]      @relation("AssignedAsset")
  agent           Agent[]      @relation("AgentUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ============================================================
// 2. CONFIGURATION (Dropdown values trong GLPI)
// ============================================================

model Manufacturer {
  id             String   @id @default(cuid())
  name           String
  website        String?
  phone          String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  assets       Asset[]
}

model State {
  id             String   @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  assets       Asset[]
}

model Location {
  id             String   @id @default(cuid())
  name           String
  address        String?
  building       String?
  room           String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  phone          String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assets       Asset[]
  users        User[]
  consumables  Consumable[]
}

model Category {
  id             String   @id @default(cuid())
  name           String
  description    String?
  type           String   @default("ticket") // ticket, problem, change, asset
  icon           String?
  color          String?
  parentId       String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryTree")
  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]
  problems     Problem[]
  changes      Change[]
}

// ============================================================
// 3. ASSET MANAGEMENT (Quản lý tài sản - lõi của GLPI)
// ============================================================

model Asset {
  id             String   @id @default(cuid())
  name           String
  assetType      String   // computer, monitor, printer, network, phone, peripheral, software, other
  serialNumber   String?
  inventoryNumber String?
  status         String   @default("in_use") // in_use, stored, repair, retired, broken
  manufacturerId String?
  stateId        String?
  locationId     String?
  organizationId String
  assignedToId   String?
  notes          String?
  purchaseDate   DateTime?
  warrantyEnd    DateTime?
  warrantyInfo   String?
  price          Float?
  isActive       Boolean  @default(true)
  isDynamic      Boolean  @default(false) // from agent
  lastInventory  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer   Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  state          State?         @relation(fields: [stateId], references: [id])
  location       Location?      @relation(fields: [locationId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  assignedTo     User?          @relation("AssignedAsset", fields: [assignedToId], references: [id])
  computerDetail    ComputerDetail?
  printerDetail     PrinterDetail?
  networkDetail     NetworkDetail?
  licenseAssignments SoftwareLicenseAssignment[]
  inventories       Inventory[]
}

model ComputerDetail {
  id             String  @id @default(cuid())
  assetId        String  @unique
  cpu            String?
  cpuCores       Int?
  cpuThreads     Int?
  cpuFrequency   String?
  ram            String?
  ramSize        Int?
  disks          String?  // JSON array
  os             String?
  osVersion      String?
  osArchitecture String?
  ipAddress      String?
  macAddress     String?
  hostname       String?
  domain         String?
  userAgent      String?  // last agent that updated

  asset Asset @relation(fields: [assetId], references: [id])
  diskVolumes  DiskVolume[]
  networkInterfaces NetworkInterface[]
  softwareInstalls  SoftwareInstall[]
}

model PrinterDetail {
  id         String @id @default(cuid())
  assetId    String @unique
  modelName  String?
  serial     String?
  ipAddress  String?
  macAddress String?
  isNetwork  Boolean @default(true)
  color      Boolean @default(false)
  duplex     Boolean @default(false)
  pagesCount Int?

  asset Asset @relation(fields: [assetId], references: [id])
}

model NetworkDetail {
  id        String @id @default(cuid())
  assetId   String @unique
  ipAddress String?
  macAddress String?
  firmware  String?
  model     String?
  portCount Int?
  isManaged Boolean @default(true)

  asset Asset @relation(fields: [assetId], references: [id])
}

model DiskVolume {
  id        String @id @default(cuid())
  detailId  String
  mountPoint String?
  totalSize Int?
  usedSize  Int?
  filesystem String?

  computer ComputerDetail @relation(fields: [detailId], references: [id])
}

model NetworkInterface {
  id        String @id @default(cuid())
  detailId  String
  name      String
  macAddress String?
  ipAddress  String?
  gateway    String?
  netmask    String?
  speed      Int?

  computer ComputerDetail @relation(fields: [detailId], references: [id])
}

model SoftwareInstall {
  id        String @id @default(cuid())
  detailId  String
  name      String
  version   String?
  publisher String?
  installDate DateTime?
  uninstallString String?

  computer ComputerDetail @relation(fields: [detailId], references: [id])
}

model SoftwareLicense {
  id             String   @id @default(cuid())
  name           String
  productName    String
  publisher      String?
  version        String?
  licenseKey     String?
  licenseType    String   // oem, retail, volume, subscription
  maxUsers       Int?
  expirationDate DateTime?
  cost           Float?
  notes          String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization                @relation(fields: [organizationId], references: [id])
  assignments       SoftwareLicenseAssignment[]
}

model SoftwareLicenseAssignment {
  id              String @id @default(cuid())
  licenseId       String
  assetId         String
  assignedAt      DateTime @default(now())

  license SoftwareLicense @relation(fields: [licenseId], references: [id])
  asset   Asset           @relation(fields: [assetId], references: [id])

  @@unique([licenseId, assetId])
}

model Consumable {
  id             String  @id @default(cuid())
  name           String
  ref            String?
  type           String  // cartridge, toner, paper, other
  stock          Int     @default(0)
  alertThreshold Int     @default(5)
  price          Float?
  locationId     String?
  organizationId String
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())

  location     Location?    @relation(fields: [locationId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================================================
// 4. AGENT & INVENTORY (Thu thập thông tin thiết bị từ agent)
// ============================================================

model Agent {
  id             String   @id @default(cuid())
  name           String
  version        String?
  deviceId       String   @unique
  lastContact    DateTime?
  lastIp         String?
  isActive       Boolean  @default(true)
  organizationId String
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation("AgentUser", fields: [userId], references: [id])
  inventories  Inventory[]
}

model Inventory {
  id             String   @id @default(cuid())
  agentId        String
  action         String   // inventory, heartbeat
  content        String   // JSON payload từ agent
  status         String   @default("received") // received, processed, error
  assetId        String?
  error          String?
  createdAt      DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])
}

// ============================================================
// 5. ITSM - TICKET (Incident & Request)
// ============================================================

model Ticket {
  id             String   @id @default(cuid())
  title          String
  description    String?
  type           String   @default("incident") // incident, request
  status         String   @default("new") // new, assigned, in_progress, pending, resolved, closed
  priority       String   @default("medium")
  urgency        String   @default("medium")
  impact         String   @default("medium")
  categoryId     String?
  assignedToId   String?
  createdById    String
  organizationId String
  dueDate        DateTime?
  closedAt       DateTime?
  resolution     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category?    @relation(fields: [categoryId], references: [id])
  assignedTo   User?        @relation("AssignedTech", fields: [assignedToId], references: [id])
  createdBy    User         @relation("CreatedBy", fields: [createdById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  followups    TicketFollowup[]
  tasks        TicketTask[]
}

model TicketFollowup {
  id        String   @id @default(cuid())
  ticketId  String
  content   String
  isPrivate Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

model TicketTask {
  id          String   @id @default(cuid())
  ticketId    String
  content     String
  state       String   @default("todo") // todo, in_progress, done
  userId      String?
  plannedTime Float?
  doneAt      DateTime?
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

// ============================================================
// 6. ITSM - PROBLEM & CHANGE
// ============================================================

model Problem {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("new")
  priority       String   @default("medium")
  categoryId     String?
  assignedToId   String?
  organizationId String
  rootCause      String?
  resolution     String?
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category?    @relation(fields: [categoryId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

model Change {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("draft")
  risk           String   @default("medium")
  impact         String   @default("medium")
  categoryId     String?
  assignedToId   String?
  organizationId String
  plannedStart   DateTime?
  plannedEnd     DateTime?
  rollbackPlan   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category?    @relation(fields: [categoryId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================================================
// 7. KNOWLEDGE BASE, DOCUMENTS & CONTRACTS
// ============================================================

model KnowledgeBaseArticle {
  id             String   @id @default(cuid())
  title          String
  content        String
  category       String?
  tags           String?
  isPublic       Boolean  @default(false)
  views          Int      @default(0)
  organizationId String
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Document {
  id             String   @id @default(cuid())
  name           String
  filename       String
  mimeType       String?
  size           Int?
  description    String?
  organizationId String
  uploadedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
}

model Contract {
  id             String   @id @default(cuid())
  name           String
  contractType   String   @default("service")
  supplierId     String?
  organizationId String
  startDate      DateTime?
  endDate        DateTime?
  renewalType    String   @default("manual")
  cost           Float?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  address        String?
  supplierType   String   @default("vendor")
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  contracts    Contract[]
}

model Budget {
  id             String   @id @default(cuid())
  name           String
  amount         Float
  spent          Float    @default(0)
  year           Int
  description    String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ============================================================
// 8. ACTIVITY LOG
// ============================================================

model Activity {
  id        String   @id @default(cuid())
  type      String   // create, update, status_change, note, agent
  content   String?
  entityType String?
  entityId  String?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
